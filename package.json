{
  "name": "erp-tests",
  "version": "2.0.0",
  "description": "Playwright automation for CRM — Enquiry flow (POM)",
  "main": "index.js",
  "scripts": {
    "chrome": "node scripts/run-chrome.js",
    "docs": "node scripts/gen-testcases.js",
    "pretest": "node scripts/gen-testcases.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:crm": "playwright test erp/crm",
    "test:item": "playwright test erp/item",
    "test:task": "playwright test erp/task-management",
    "test:project": "playwright test erp/project-management",
    "test:enquiry": "playwright test erp/crm/tests/enquiry_flow.spec.js",
    "test:enquiry:headed": "playwright test erp/crm/tests/enquiry_flow.spec.js --headed",
    "report": "playwright show-report reports/html",
    "ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "test:hrms": "playwright test -c hrms/playwright.config.js",
    "test:hrms:smoke": "playwright test -c hrms/playwright.config.js hrms/tests/00_smoke",
    "hrms": "node hrms/scripts/run-module.js",
    "hrms:core-hr": "node hrms/scripts/run-module.js core-hr",
    "hrms:recruitment": "node hrms/scripts/run-module.js recruitment",
    "hrms:onboarding": "node hrms/scripts/run-module.js onboarding",
    "hrms:attendance": "node hrms/scripts/run-module.js attendance",
    "hrms:leave": "node hrms/scripts/run-module.js leave",
    "hrms:payroll": "node hrms/scripts/run-module.js payroll",
    "hrms:ess": "node hrms/scripts/run-module.js ess",
    "hrms:helpdesk": "node hrms/scripts/run-module.js helpdesk",
    "hrms:referral": "node hrms/scripts/run-module.js referral",
    "hrms:resignation": "node hrms/scripts/run-module.js resignation",
    "hrms:wfh": "node hrms/scripts/run-module.js wfh",
    "hrms:linear": "node hrms/scripts/run-module.js linear",
    "hrms:all": "node hrms/scripts/run-module.js all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "playwright": "^1.60.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
